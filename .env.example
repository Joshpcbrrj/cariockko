# Cariockko Environment Variables
# For local development with Docker Compose

# Choose OpenAI cloud or local Ollama + audio services
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL_CHAT=gpt-4o-mini
AI_PROVIDER=openai
# Local AI (Ollama + OpenAI-compatible local audio servers)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
LOCAL_STT_BASE_URL=http://host.docker.internal:8000/v1
LOCAL_STT_MODEL=Systran/faster-whisper-small
LOCAL_TTS_BASE_URL=http://host.docker.internal:8880/v1
LOCAL_TTS_MODEL=kokoro
LOCAL_TTS_VOICE=af_heart
# OpenAI STT/TTS models are selected by the application.
# Lessons generated in parallel
GEN_CONCURRENCY=3

# PostgreSQL
POSTGRES_DB=postgres
POSTGRES_PASSWORD=local-dev-password
# Port on this machine for database tools; change it if 5432 is already in use.
POSTGRES_HOST_PORT=5432

# MinIO (S3-compatible object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# API
DATABASE_URL=postgresql://postgres:local-dev-password@db:5432/postgres
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_BUCKET=audio

# Web
# Client-side fetches use same-origin relative paths (proxied via Next.js
# rewrites — see web/next.config.ts). NEXT_PUBLIC_API_URL is kept for
# backwards compat with older builds.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Used by Next.js (server-side) to proxy /api/* and /audio/* to the
# backend services. Inside docker-compose these resolve to the service
# names; for local `next dev` they default to localhost.
# API_INTERNAL_URL=http://api:3001
# MINIO_INTERNAL_URL=http://minio:9000
